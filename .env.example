# YusufMart Environment Configuration Template
# Copy this file to .env or set these environment variables in your deployment environment.

# HTTP Server Port
PORT=8080

# Database Configuration (H2 embedded or server mode)
JDBC_URL=jdbc:h2:./data/yusufmart;DB_CLOSE_DELAY=-1
JDBC_USER=sa
JDBC_PASSWORD=

# Session Timeout (in minutes)
SESSION_TIMEOUT_MINUTES=30
